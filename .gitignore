# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
# NOTE: src/shellcraft.egg-info/ is untracked and ignored here. It is a build
# artifact regenerated by every `uv sync`/`pip install -e`, not source.
*.egg-info/
dist/
build/

# Environments
.venv/
env/
venv/

# Test and coverage artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Tool caches
.ruff_cache/
.mypy_cache/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store

# NOTE: uv.lock is deliberately NOT ignored. This project is managed with uv,
# and without a committed lockfile installs are not reproducible - and the
# `uv sync --frozen` used by pre-commit and CI has nothing to freeze to.
